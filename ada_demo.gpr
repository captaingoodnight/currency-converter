project Ada_Demo is

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src");
   for Object_Dir  use "obj";
   for Exec_Dir    use ".";
   for Main        use ("currency_converter.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnatwa");
      for Default_Switches ("C")   use ("-g", "-O2", "-Wall", "-Wextra");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-lncurses");
   end Linker;

end Ada_Demo;

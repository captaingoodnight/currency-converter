--  Tracked copy of the gnattest harness config. `obj/` is gitignored and
--  wiped by `gprclean`/`gnattest` regeneration, so gnattest_common.gpr
--  itself can't live there under version control. After any full
--  regeneration, copy this file back over
--  obj/gnattest/harness/gnattest_common.gpr before building the harness.
abstract project Gnattest_Common is
   for Languages use ("Ada");
   for Source_Files use ();

   type TD_Compilation_Type is ("contract-checks","no-contract-checks", "no-config-file");
   TD_Compilation : TD_Compilation_Type := external ("TEST_DRIVER_BUILD_MODE", "no-config-file");

   package Builder is
      case TD_Compilation is
         when "contract-checks" =>
            for Global_Configuration_Pragmas use "suppress.adc";
         when "no-contract-checks" =>
            for Global_Configuration_Pragmas use "suppress_no_ghost.adc";
         when "no-config-file" =>
            null;
      end case;
   end Builder;

   Ncurses_Prefix := Project'Project_Dir & "../../../third_party/ncurses/install";

   package Linker is
      for Default_Switches ("ada") use
        ("-g", "-L" & Ncurses_Prefix & "/lib", "-lncurses");
   end Linker;

   package Binder is
      for Default_Switches ("ada") use ("-E", "-static");
   end Binder;

   Contract_Switches := ();
   case TD_Compilation is
      when "contract-checks" =>
         Contract_Switches := ("-gnata");
      when others =>
         null;
   end case;
   package Compiler is
      for Default_Switches ("ada") use
        ("-g", "-gnatyM0") & Contract_Switches;
   end Compiler;

end Gnattest_Common;

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Project",
            "type": "shell",
            "command": "gprbuild --config=default.cgpr -P ada_demo.gpr",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "ada",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "CodeSonar: Build Ada",
            "type": "shell",
            "command": "codesonar build /home/sevoy/projects/currency_converter localhost:7340 codesonar ada_scan.py ada_demo.gpr",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "CodeSonar: Build C",
            "type": "shell",
            "command": "codesonar build /home/sevoy/projects/currency_converter localhost:7340 gprbuild --config=default.cgpr -P ada_demo.gpr -f -v",
            "group": "test",
            "dependsOn": "CodeSonar: Build Ada",
            "problemMatcher": []
        },
        {
            "label": "Analyze Project",
            "type": "shell",
            "command": "codesonar analyze /home/sevoy/projects/currency_converter localhost:7340",
            "group": "test",
            "dependsOn": "CodeSonar: Build C",
            "problemMatcher": []
        }
    ]
}

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Project",
            "type": "shell",
            "command": "gprbuild -P ada_demo.gpr",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "ada",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Analyze Project",
            "type": "shell",
            "command": "codesonar analyze currency_converter localhost:7340 condesonar ada_scan.py ada_demo.gpr",
            "group": "test",
            "problemMatcher": []
        }
    ]
}
